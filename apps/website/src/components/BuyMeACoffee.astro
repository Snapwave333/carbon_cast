---
import { BUY_ME_A_COFFEE_URL } from '../data/support';

interface Props {
  variant?: 'button' | 'link';
  label?: string;
}

const { variant = 'button', label = 'Buy me a coffee' } = Astro.props;

const buttonClass = 'btn-secondary group';
const linkClass =
  'group inline-flex items-center gap-2 text-sm text-surface-500 transition-colors duration-200 hover:text-accent-400';
---

{
  BUY_ME_A_COFFEE_URL && (
    <a
      href={BUY_ME_A_COFFEE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={variant === 'button' ? buttonClass : linkClass}
    >
      <svg
        class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 10h12v6a4 4 0 01-4 4H8a4 4 0 01-4-4v-6zm12 1h1.5a2.5 2.5 0 010 5H16M7 3v3M11 3v3"
        />
      </svg>
      {label}
    </a>
  )
}
