---
const textCells = [
  {
    title: 'Your own players',
    body: 'Play inline, or hand the stream to MPV, VLC or the experimental embedded MPV engine without leaving the app.',
  },
  {
    title: 'Runs everywhere',
    body: 'A desktop app for macOS, Windows and Linux, plus a Progressive Web App you can host yourself.',
  },
];
---

<section id="features" class="py-24">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl lg:text-5xl">
        The parts that usually go missing
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-surface-400">
        A programme guide that works, players you already trust, and nothing
        phoning home about what you watched.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <!-- Guide: the anchor cell, carries a real screenshot. -->
      <article
        class="reveal panel flex flex-col overflow-hidden md:col-span-2 lg:row-span-2"
      >
        <div class="p-7">
          <h3 class="font-display text-2xl font-bold tracking-tight text-surface-50">
            A guide, not a channel dump
          </h3>
          <p class="mt-3 max-w-[48ch] text-sm leading-relaxed text-surface-400">
            Point it at any XMLTV source and CarbonCast parses it in a worker
            thread, stores it, and keeps the timeline usable at ninety thousand
            channels. Map awkward channels to the right guide entry by hand when
            the ids do not line up.
          </p>
        </div>
        <div class="mt-auto overflow-hidden border-t border-surface-800/80">
          <img
            src="/carbon_cast/screenshots/multi-epg-view.webp"
            alt="The multi-channel programme guide"
            width="1600"
            height="1000"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
        </div>
      </article>

      {
        textCells.map((cell, index) => (
          <article class="reveal panel p-7 lg:col-span-2" data-delay={index + 1}>
            <h3 class="font-display text-xl font-bold tracking-tight text-surface-50">
              {cell.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-surface-400">{cell.body}</p>
          </article>
        ))
      }

      <!-- Privacy: the one tinted cell, so the grid is not four grey boxes. -->
      <article
        class="reveal relative overflow-hidden rounded-xl border border-accent-500/25 p-7 md:col-span-2 lg:col-span-2"
        data-delay="3"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_0%,rgba(32,168,168,0.16),transparent_65%)]"
        >
        </div>
        <div class="relative">
          <h3 class="font-display text-xl font-bold tracking-tight text-surface-50">
            Nothing phones home
          </h3>
          <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-surface-300">
            No account, no analytics, no telemetry. Playlists and watch history
            live in a local SQLite file on your machine, and the source is on
            GitHub if you would rather check than take our word for it.
          </p>
        </div>
      </article>

      <!-- Radio: closes the grid on its own screenshot. -->
      <article
        class="reveal panel flex flex-col overflow-hidden md:col-span-2 lg:col-span-2"
        data-delay="1"
      >
        <div class="overflow-hidden border-b border-surface-800/80">
          <img
            src="/carbon_cast/screenshots/radio-feature.webp"
            alt="The radio and podcast browser"
            width="1400"
            height="900"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
        </div>
        <div class="p-7">
          <h3 class="font-display text-xl font-bold tracking-tight text-surface-50">
            Radio and podcasts, no playlist needed
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-surface-400">
            Browse public station catalogues and podcast feeds straight out of the
            box. Subscriptions and resume points stay on your device.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
