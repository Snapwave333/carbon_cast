---
import { Image } from 'astro:assets';
import heroShot from '../assets/screenshots/player.png';
---

<section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 lg:pb-28">
  <!-- The page's one ambient light source, anchored to the hero. -->
  <div
    class="pointer-events-none absolute -top-40 right-0 h-[560px] w-[720px] rounded-full bg-accent-500/[0.07] blur-[130px]"
  >
  </div>

  <div class="relative mx-auto grid max-w-[1400px] items-center gap-14 px-6 lg:grid-cols-[minmax(0,46%)_minmax(0,54%)] lg:gap-10 lg:px-10">
    <div class="reveal">
      <div class="inline-flex items-center gap-3">
        <span class="h-px w-7 bg-accent-500/60"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-500">
          Open source IPTV player
        </span>
      </div>

      <h1 class="mt-7 font-display text-[2.75rem] font-bold leading-[1.05] tracking-tight text-surface-50 sm:text-6xl lg:text-[4rem]">
        Every playlist.<br />
        <em class="pb-1 font-medium not-italic leading-[1.1] text-accent-400" style="font-style: italic;">
          One player.
        </em>
      </h1>

      <p class="mt-7 max-w-[46ch] text-lg leading-relaxed text-surface-400">
        M3U, Xtream Codes and Stalker portals in one desktop app. Free, open
        source, and yours to self-host.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/carbon_cast/download/" class="btn-primary">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            />
          </svg>
          Download
        </a>
        <a
          href="https://github.com/Snapwave333/carbon_cast"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
          View the source
        </a>
      </div>
    </div>

    <!-- Product shot bleeds past the right edge on wide viewports. -->
    <div class="reveal relative lg:-mr-10 xl:-mr-24" data-delay="1">
      <div
        class="overflow-hidden rounded-xl border border-surface-700/50 bg-surface-900 shadow-2xl shadow-black/50"
      >
        <Image
          src={heroShot}
          alt="CarbonCast IPTV playing a live channel beside its channel list and programme guide"
          width={1251}
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
