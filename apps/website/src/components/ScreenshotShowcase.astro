---
const shots = [
  {
    src: '/carbon_cast/screenshots/dashboard-with-content.webp',
    caption: 'The dashboard picks up where you stopped watching.',
  },
  {
    src: '/carbon_cast/screenshots/multi-epg-view.webp',
    caption: 'A full XMLTV guide across every channel in the playlist.',
  },
  {
    src: '/carbon_cast/screenshots/vod-details.webp',
    caption: 'Movie and series pages, enriched with TMDB when you allow it.',
  },
  {
    src: '/carbon_cast/screenshots/global-search.webp',
    caption: 'One search box across every playlist and portal you added.',
  },
  {
    src: '/carbon_cast/screenshots/radio-feature.webp',
    caption: 'Internet radio and podcasts, no playlist required.',
  },
  {
    src: '/carbon_cast/screenshots/light-theme.webp',
    caption: 'Light theme, for the people who want it.',
  },
];
---

<section id="screenshots" class="overflow-hidden py-24">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-500">
          The interface
        </span>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">
          Built to hold a very large playlist
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-surface-400">
        Every screen below is the real app, not a mockup. Drag to see the rest.
      </p>
    </div>
  </div>

  <div class="rail mt-12 gap-5 px-6 pb-6 lg:px-10" tabindex="0" aria-label="Application screenshots">
    {
      shots.map((shot) => (
        <figure class="w-[85vw] max-w-[900px] shrink-0 snap-start sm:w-[70vw]">
          <div class="overflow-hidden rounded-xl border border-surface-700/50 bg-surface-900">
            <img
              src={shot.src}
              alt={shot.caption}
              width="1600"
              height="1100"
              loading="lazy"
              decoding="async"
              class="h-auto w-full"
            />
          </div>
          <figcaption class="mt-4 text-sm text-surface-400">{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>
