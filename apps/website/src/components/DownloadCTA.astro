---
import { CONTAINER_IMAGE, LATEST_VERSION, platforms, assetUrl } from '../data/downloads';

const quickLinks = platforms.map((platform) => ({
  id: platform.id,
  name: platform.name,
  icon: platform.icon,
  href: assetUrl((platform.assets.find((asset) => asset.primary) ?? platform.assets[0]).file),
}));

const dockerCommand = `docker run -d -p 4333:80 ${CONTAINER_IMAGE}:latest`;
---

<section id="download" class="py-24">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="reveal panel-inset overflow-hidden">
      <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-500">
            Version {LATEST_VERSION}
          </span>
          <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">
            Install it in about a minute
          </h2>
          <p class="mt-4 max-w-[52ch] text-surface-400">
            No account and no licence key. Grab the build for your machine, or run
            the browser version in a container.
          </p>

          <div class="mt-8 flex items-center gap-4 rounded-lg border border-surface-800 bg-surface-950 px-4 py-3">
            <code class="flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs text-accent-400/90">
              {dockerCommand}
            </code>
            <button
              class="copy-btn shrink-0 rounded-lg p-1.5 text-surface-600 transition-colors hover:text-surface-300"
              data-command={dockerCommand}
              aria-label="Copy the Docker command"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"
                />
              </svg>
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-3 lg:w-64">
          {
            quickLinks.map((platform) => (
              <a
                href={platform.href}
                class="group flex items-center gap-3.5 rounded-lg border border-surface-700/60 px-5 py-3.5 transition-all duration-200 hover:border-accent-500/50 hover:bg-accent-500/[0.06]"
              >
                <svg
                  class="h-5 w-5 shrink-0 text-surface-500 transition-colors group-hover:text-accent-400"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d={platform.icon} />
                </svg>
                <span class="text-sm font-medium text-surface-200">{platform.name}</span>
              </a>
            ))
          }
          <a
            href="/carbon_cast/download/"
            class="mt-1 text-center font-mono text-[11px] uppercase tracking-[0.12em] text-surface-500 transition-colors hover:text-accent-400"
          >
            All builds and install steps
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const command = btn.dataset.command;
      if (!command) return;

      await navigator.clipboard.writeText(command);
      const svg = btn.querySelector('svg');
      if (!svg) return;

      const original = svg.innerHTML;
      svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />';
      setTimeout(() => {
        svg.innerHTML = original;
      }, 1500);
    });
  });
</script>
